# ==========================================
# HealthLens AI Backend Environment Variables
# ==========================================

# Supabase (database only — authentication is handled by Clerk)
SUPABASE_URL=https://your-project.supabase.co
# Service-role key is preferred: RLS tied to Supabase Auth no longer applies.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNkY2FwaXlmcmFuc3ZrcWx3amx6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODIzNzIzNywiZXhwIjoyMTAzODEzMjM3fQ.FqJ-T7_heGgMLZ5O6cGPUUkY3aSmXqXQOCn9SX3lHk8
# Fallback for local dev if a service-role key is not configured.
SUPABASE_KEY=sb_publishable_uXayOZW1jHWlr0f3nMgXcw_THSL2tyv
# Clerk Authentication
# Issuer: Clerk Dashboard -> Configure -> JWT Templates -> Issuer
# (typically https://your-app.clerk.accounts.dev)
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# OpenRouter / LLM Insights API Key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=openrouter/free

# CORS & Allowed Domains (comma-separated for custom domains)
# Note: Localhost and *.vercel.app are automatically allowed by default
ALLOWED_ORIGINS=http://localhost:3000,https://your-custom-frontend.vercel.app

# Server Port (Render sets this automatically)
PORT=8000

