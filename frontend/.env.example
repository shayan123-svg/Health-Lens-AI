# ==========================================
# HealthLens AI Frontend Environment Variables
# ==========================================

# Clerk Publishable Key (public value, safe for browser).
# Get it from: Clerk Dashboard -> Configure -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# FastAPI Backend URL (Render URL in production)
# Example for Render: https://healthlens-api.onrender.com
# Example for local development: http://localhost:8000
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com
