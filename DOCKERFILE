# ==========================================================
# HealthLens AI - Unified All-in-One Dockerfile
# Runs BOTH FastAPI Backend & Next.js Frontend in a SINGLE container
# Perfect for 1-click cloud deployments (Render, Railway, Fly.io)
# ==========================================================

# ----------------------------------------------------------
# Stage 1: Build Next.js Frontend
# ----------------------------------------------------------
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package.json frontend/bun.lock* frontend/package-lock.json* ./
RUN npm install -g bun && (bun install --frozen-lockfile || npm install)

COPY frontend/ ./
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build || (bun run build)

# ----------------------------------------------------------
# Stage 2: Unified Runtime with Python 3.11 and Node.js
# ----------------------------------------------------------
FROM python:3.11-slim AS runner

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NODE_ENV=production

WORKDIR /app

# Install Node.js 20, curl, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Python backend dependencies
COPY Backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r ./backend/requirements.txt

# Copy Backend files and ML model artifacts
COPY Backend/app ./backend/app
COPY Backend/Model_Pickle_Files ./backend/Model_Pickle_Files
COPY Backend/uploads ./backend/uploads

# Copy Frontend build from stage 1
COPY --from=frontend-builder /app/frontend/package.json ./frontend/package.json
COPY --from=frontend-builder /app/frontend/node_modules ./frontend/node_modules
COPY --from=frontend-builder /app/frontend/public ./frontend/public
COPY --from=frontend-builder /app/frontend/.next ./frontend/.next

# Startup script: Launches FastAPI on 8000, Next.js on $PORT (Render sets PORT)
RUN echo '#!/bin/sh' > /app/entrypoint.sh && \
    echo 'export FRONTEND_PORT=${PORT:-3000}' >> /app/entrypoint.sh && \
    echo 'echo "Starting FastAPI Backend on internal port 8000..."' >> /app/entrypoint.sh && \
    echo 'cd /app/backend && uvicorn app.main:app --host 127.0.0.1 --port 8000 &' >> /app/entrypoint.sh && \
    echo 'echo "Waiting for Backend to initialize..."' >> /app/entrypoint.sh && \
    echo 'sleep 3' >> /app/entrypoint.sh && \
    echo 'echo "Starting Next.js Frontend on public port $FRONTEND_PORT..."' >> /app/entrypoint.sh && \
    echo 'cd /app/frontend && exec npm run start -- -p "$FRONTEND_PORT" -H 0.0.0.0' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

# Expose default port
EXPOSE 3000

# Health check verifies the running service
HEALTHCHECK --interval=25s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT:-3000}/health || exit 1

CMD ["/app/entrypoint.sh"]
